# ===== Stripe =====
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ===== Firebase Admin (cole o JSON da service account em UMA linha) =====
# Console Firebase → Configurações → Contas de serviço → Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"lugh-world-community-3c7d3", ...}

# ===== App =====
PUBLIC_SITE_URL=https://seu-site.com
ADMIN_EMAILS=romanohenri@gmail.com
PORT=8787

# ===== Discord OAuth =====
# Discord Developer Portal → OAuth2 → Redirects:
# https://SEU-BACKEND-RENDER.onrender.com/api/auth/discord/callback
PUBLIC_API_URL=https://SEU-BACKEND-RENDER.onrender.com
DISCORD_CLIENT_ID=seu_client_id
DISCORD_CLIENT_SECRET=seu_client_secret
DISCORD_REDIRECT_URI=https://SEU-BACKEND-RENDER.onrender.com/api/auth/discord/callback

# ===== Steam News automático =====
# 1440 minutos = 1 vez por dia. O cron externo garante a execução mesmo se o Render dormir.
STEAM_NEWS_AUTO_IMPORT_MINUTES=1440
# Use uma chave longa e aleatória; o cron deve chamar /api/cron/steam-news/import?secret=SUA_CHAVE
CRON_SECRET=troque_por_uma_chave_grande
